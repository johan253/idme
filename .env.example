# App
APP_ENV=local
PORT=8080

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-too
JWT_TTL_SECONDS=600

# JWK
JWK_KEK=superrandomandsecretvaluedonotusethisoneok+= # Key used to encrypt private key in db
JWK_REFRESH_SECONDS=60 # How often each process refreshes available keys from db
JWK_GRACE_SECONDS=60 # Grace period after JWT TTL expiry to prune JWK

# Postgres
# POSTGRES_HOST is the docker-compose service name when running via compose,
# and "localhost" when running the binary against a local Postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=identity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SSL_MODE=disable

# Optional: if set, overrides the URL built from the POSTGRES_* vars above.
# POSTGRES_URL=postgres://postgres:password@postgres:5432/identity?sslmode=disable
